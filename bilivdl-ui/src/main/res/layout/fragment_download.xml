<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_horizontal_padding"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/page_horizontal_padding"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="下载管理"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="查看进度、管理任务，失败任务可以继续重试"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/surface_dark"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_dark"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/download_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正在读取下载任务…"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clear_completed"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="清理已完成"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="11dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/retry_failed"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="重试失败"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/surface_elevated"
                        app:cornerRadius="11dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clear_history"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:minWidth="0dp"
                        android:text="清空历史"
                        android:textAllCaps="false"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/download_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_empty_card"
            android:gravity="center"
            android:minHeight="132dp"
            android:padding="22dp"
            android:text="还没有下载任务"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/download_task_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
